<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="ASP.NET_WebForms_Practicals.Unit_3.SiteMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Master Page Website</title>
    <style type="text/css">
        body { font-family: 'Segoe UI', Arial, sans-serif; margin: 0; padding: 0; background-color: #f4f4f4; }
        .header { background-color: #003366; color: white; padding: 20px; text-align: center; }
        .nav { background-color: #004080; padding: 10px; text-align: center; }
        .nav a { color: white; text-decoration: none; margin: 0 15px; font-weight: bold; }
        .nav a:hover { text-decoration: underline; }
        .main-content { background: white; max-width: 800px; margin: 20px auto; padding: 20px; border-radius: 6px; box-shadow: 0 0 10px rgba(0,0,0,0.1); }
        .footer { background-color: #222; color: #aaa; text-align: center; padding: 15px; position: fixed; width: 100%; bottom: 0; }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="header">
            <h1>Demo College Academic Portal</h1>
            <p>Unit 3 - Practical 3: Master Page Illustration</p>
        </div>

        <div class="nav">
            <a href="Home.aspx">Home</a>
            <a href="About.aspx">About Us</a>
        </div>

        <div class="main-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <div class="footer">
            &copy; <%: DateTime.Now.Year %> Demo College. All Rights Reserved.
        </div>
    </form>
</body>
</html>
